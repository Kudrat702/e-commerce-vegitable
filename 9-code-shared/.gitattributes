# Set default behavior to automatically normalize line endings
* text=auto

# Force Unix-style LF line endings for code files
*.js     text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.sh     text eol=lf

# Images and binary files should be left untouched
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
